<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.example</groupId>
	<artifactId>playwright-introduction</artifactId>
	<version>1.0-SNAPSHOT</version>

	<properties>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Override with e.g. mvn test -Dapp.url=https://your-server/app/ -Dheadless=false -->
		<app.url>http://localhost:5001/app/</app.url>
		<browser.type>chromium</browser.type>
		<headless>true</headless>
		<!-- on | off | retain-on-failure -->
		<trace>retain-on-failure</trace>
		<allure.version>3.0.0</allure.version>
		<aspectj.version>1.9.25</aspectj.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- keeps junit-platform-launcher (pulled in by Allure) aligned with Jupiter -->
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>6.1.3</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>io.qameta.allure</groupId>
				<artifactId>allure-bom</artifactId>
				<version>${allure.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>com.microsoft.playwright</groupId>
			<artifactId>playwright</artifactId>
			<version>1.63.0</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>6.1.3</version>
			<scope>test</scope>
		</dependency>
		<!-- Allure results (target/allure-results); @Step and @Attachment need the AspectJ agent in Surefire's argLine -->
		<dependency>
			<groupId>io.qameta.allure</groupId>
			<artifactId>allure-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Only used for the Selenium vs Playwright comparison -->
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-java</artifactId>
			<version>4.50.0</version>
			<scope>test</scope>
		</dependency>
		<!-- Only used to inspect the PDF tickets: text extraction, rendering, QR code -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.5</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.google.zxing</groupId>
			<artifactId>javase</artifactId>
			<version>3.5.3</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.6</version>
				<configuration>
					<argLine>-javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"</argLine>
					<systemPropertyVariables>
						<app.url>${app.url}</app.url>
						<browser.type>${browser.type}</browser.type>
						<headless>${headless}</headless>
						<trace>${trace}</trace>
					</systemPropertyVariables>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>org.aspectj</groupId>
						<artifactId>aspectjweaver</artifactId>
						<version>${aspectj.version}</version>
					</dependency>
				</dependencies>
			</plugin>
			<!-- mvn test surefire-report:report  ->  target/site/surefire-report.html -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-report-plugin</artifactId>
				<version>3.5.6</version>
				<configuration>
					<linkXRef>false</linkXRef>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- mvn verify -Pci : what the pipeline uses. A failing test is run once more; if it then passes, Surefire reports it as a flake. -->
		<profile>
			<id>ci</id>
			<properties>
				<headless>true</headless>
				<trace>retain-on-failure</trace>
				<surefire.rerunFailingTestsCount>1</surefire.rerunFailingTestsCount>
			</properties>
		</profile>
	</profiles>

</project>
